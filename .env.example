# Copy to .env for `npm run start:dev` (the api container gets its env from docker-compose.yml).

PORT=3000

# From the host machine you MUST use directConnection=true: the replica set
# advertises its member as "mongo:27017", a name only resolvable inside Docker.
MONGO_URI=mongodb://localhost:27017/lastroom?directConnection=true

# Optional at runtime: if Redis is down the API still works (health = "degraded").
REDIS_URL=redis://localhost:6379

# Sent by operator clients as the X-Api-Key header. At least 16 characters.
# Placeholder only: generate your own, e.g. `openssl rand -hex 24`.
API_KEY=local-dev-api-key-change-me
